{
  "name": "git-saiyan",
  "version": "1.3.0",
  "description": "Dynamic contribution-driven Dragon Ball pixel-art companion for GitHub profiles",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "git-saiyan": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "preview:art": "tsx scripts/preview-art.ts",
    "gallery": "tsx scripts/gallery.ts",
    "scenarios": "tsx scripts/scenarios.ts",
    "designs": "tsx scripts/designs.ts",
    "start": "node dist/cli.js",
    "test": "tsx tests/run.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "github-action",
    "dragon-ball",
    "goku",
    "profile-readme",
    "gamification",
    "pixel-art",
    "contributions",
    "readme",
    "svg",
    "gif"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@octokit/graphql": "^9.0.5",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
